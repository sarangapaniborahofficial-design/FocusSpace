{
  "name": "focusspace",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "prepare-voice": "node scripts/provision-voice.mjs",
    "setup:voice": "node scripts/fetch-models.mjs",
    "check:voice": "node scripts/check-voice-assets.mjs --strict",
    "package:zip": "python scripts/package-clean-zip.py",
    "argus": "node scripts/argus.mjs",
    "test:argus": "node scripts/argus.mjs",
    "postinstall": "node scripts/provision-voice.mjs && node scripts/check-voice-assets.mjs"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@huggingface/transformers": "^4.3.1",
    "@ricky0123/vad-web": "^0.0.31",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vitejs/plugin-react": "6.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "6.2.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "build": {
    "appId": "com.focusspace.desktop",
    "productName": "FocusSpace",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon-192.png",
      "public/icon-512.png"
    ],
    "asarUnpack": [
      "dist/models/**/*",
      "dist/vad/**/*",
      "dist/ort/**/*",
      "dist/assets/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusSpace"
    }
  }
}
